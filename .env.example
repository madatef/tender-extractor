# ── Django ──────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Supabase / PostgreSQL ────────────────────────────────
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ── Redis ────────────────────────────────────────────────
# Local dev: redis://localhost:6379/0
# Docker:    redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── LLM Routing ─────────────────────────────────────────
PRIMARY_LLM_PROVIDER=openai_mini
FALLBACK_LLM_PROVIDER=openai_full
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# ── Slack ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Rate Limiting ────────────────────────────────────────
THROTTLE_RATE_USER=30/minute

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Production only ──────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://your-client.com,https://client2.org
